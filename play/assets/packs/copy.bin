{
  "status": "editorial-draft",
  "tips": [
    {
      "id": "tip.01",
      "en": "Listen for the first fine crack before the chips fall.",
      "zh-CN": "先听第一道细裂，再听碎片落下。"
    },
    {
      "id": "tip.02",
      "en": "A slow press helps you see the dent form.",
      "zh-CN": "慢一点按，可以看清凹陷是怎么形成的。"
    },
    {
      "id": "tip.03",
      "en": "Release a foam toy and watch the shape come back.",
      "zh-CN": "松开泡棉玩具，看它慢慢恢复。"
    },
    {
      "id": "tip.04",
      "en": "Try pressing near the edge of a brittle shell.",
      "zh-CN": "试试从脆壳边缘下手。"
    },
    {
      "id": "tip.05",
      "en": "Turn a reusable pop board over when the domes are down.",
      "zh-CN": "可重复泡泡板按满后，可以翻面再玩。"
    },
    {
      "id": "tip.06",
      "en": "Move slowly when lifting the edge of a peel toy.",
      "zh-CN": "揭起撕膜玩具的边缘时，可以慢一点。"
    },
    {
      "id": "tip.07",
      "en": "Compare the sound of chocolate with caramel.",
      "zh-CN": "听听巧克力和焦糖的断裂声有什么不同。"
    },
    {
      "id": "tip.08",
      "en": "One toy can sound different near its center and edge.",
      "zh-CN": "同一款玩具，中心和边缘的声音可能不同。"
    },
    {
      "id": "tip.09",
      "en": "Use headphones at a comfortable volume.",
      "zh-CN": "戴耳机时，记得把音量调到舒服的位置。"
    },
    {
      "id": "tip.10",
      "en": "Look for finer crumbs on granular toys.",
      "zh-CN": "观察颗粒玩具散落时形成的细屑。"
    },
    {
      "id": "tip.11",
      "en": "Try a different tool on the same material.",
      "zh-CN": "拿另一种工具试试同一种材质。"
    },
    {
      "id": "tip.12",
      "en": "The spoon taps in a smaller area than the mallet.",
      "zh-CN": "小勺的接触范围比木槌小。"
    },
    {
      "id": "tip.13",
      "en": "The rolling pin makes a broader impression.",
      "zh-CN": "擀面杖能压出更宽的痕迹。"
    },
    {
      "id": "tip.14",
      "en": "Try the tweezers when a film edge lifts.",
      "zh-CN": "膜边翘起时，可以试试镊子。"
    },
    {
      "id": "tip.15",
      "en": "Hold a pull toy with two fingers and spread them apart.",
      "zh-CN": "用两根手指拉开拉丝捏捏。"
    },
    {
      "id": "tip.16",
      "en": "Release a stretch toy before starting the next pull.",
      "zh-CN": "下一次拉伸前，先松开玩具。"
    },
    {
      "id": "tip.17",
      "en": "Some toys wobble briefly after you lift your finger.",
      "zh-CN": "有些玩具松手后还会晃几下。"
    },
    {
      "id": "tip.18",
      "en": "Bubbles inside clear gel make its movement easier to see.",
      "zh-CN": "透明凝胶里的气泡能帮你看清它的形变。"
    },
    {
      "id": "tip.19",
      "en": "Try a light poke on a jelly toy before a deep press.",
      "zh-CN": "先轻戳果冻，再试试深按。"
    },
    {
      "id": "tip.20",
      "en": "Watch the opposite side when you squeeze a bulge toy.",
      "zh-CN": "挤压鼓包玩具时，看看另一侧。"
    },
    {
      "id": "tip.21",
      "en": "A crisp click is easier to hear between slower taps.",
      "zh-CN": "按慢一点，指尖按键的咔哒声更容易听清。"
    },
    {
      "id": "tip.22",
      "en": "Try different spots on a putty toy to make a pattern.",
      "zh-CN": "在泥类玩具上换几个位置，可以压出图案。"
    },
    {
      "id": "tip.23",
      "en": "A new session is a chance to try a different material.",
      "zh-CN": "每次打开游戏，都可以试一种没玩过的材质。"
    },
    {
      "id": "tip.24",
      "en": "Your shelf is a place to display the toys you like.",
      "zh-CN": "收藏架可以摆上你喜欢的玩具。"
    },
    {
      "id": "tip.25",
      "en": "Put toys with contrasting colors next to each other.",
      "zh-CN": "试试把颜色反差大的玩具摆在一起。"
    },
    {
      "id": "tip.26",
      "en": "A display stand can make a small toy easier to spot.",
      "zh-CN": "展示台能让小玩具更好找。"
    },
    {
      "id": "tip.27",
      "en": "Try a darker cloth to show off clear gel.",
      "zh-CN": "透明凝胶放在较深的桌布上更显眼。"
    },
    {
      "id": "tip.28",
      "en": "Use a lighter cloth when dark toy edges are hard to see.",
      "zh-CN": "深色玩具边缘不清楚时，可以换浅色桌布。"
    },
    {
      "id": "tip.29",
      "en": "Check Today’s Toy to explore a featured shape.",
      "zh-CN": "看看今日玩具，试试推荐的造型。"
    },
    {
      "id": "tip.30",
      "en": "An empty spot in the catalog shows a toy you haven’t found.",
      "zh-CN": "图鉴里的空位代表还没找到的玩具。"
    },
    {
      "id": "tip.31",
      "en": "Rarity shapes can help you tell tiers apart without color.",
      "zh-CN": "稀有度形状能帮你区分不同等级。"
    },
    {
      "id": "tip.32",
      "en": "You can change text size in Accessibility.",
      "zh-CN": "可在无障碍设置中调整字号。"
    },
    {
      "id": "tip.33",
      "en": "Turn on reduced motion if you prefer calmer transitions.",
      "zh-CN": "如果想要更平静的转场，可以开启减少动态效果。"
    },
    {
      "id": "tip.34",
      "en": "Sound captions describe selected effects on screen.",
      "zh-CN": "声音字幕会在屏幕上描述部分音效。"
    },
    {
      "id": "tip.35",
      "en": "One-handed mode moves supported controls closer to the bottom.",
      "zh-CN": "单手模式会把支持的控件移到下方。"
    },
    {
      "id": "tip.36",
      "en": "Cover the screen in a listening challenge only after reading the choices.",
      "zh-CN": "想闭眼猜材质时，先看清盲听选项。"
    },
    {
      "id": "tip.37",
      "en": "In a pattern challenge, pause and look at the target before tapping.",
      "zh-CN": "做图案挑战时，先看清目标再按。"
    },
    {
      "id": "tip.38",
      "en": "A friend challenge is a chance to compare approaches to the same toy.",
      "zh-CN": "好友挑战可以比较两个人玩同一款的方式。"
    },
    {
      "id": "tip.39",
      "en": "Share a toy you enjoyed so a friend can find the same one.",
      "zh-CN": "把你喜欢的玩具分享出去，让朋友也能找到它。"
    },
    {
      "id": "tip.40",
      "en": "You can check your supply before starting another consumable toy.",
      "zh-CN": "再开一次性玩具前，可以先看剩余数量。"
    },
    {
      "id": "tip.41",
      "en": "If a toy is used up, check the refill screen.",
      "zh-CN": "用完的玩具可以在补货页查看。"
    },
    {
      "id": "tip.42",
      "en": "A reusable toy can be reset and played again.",
      "zh-CN": "可重复玩具可以重置后再玩。"
    },
    {
      "id": "tip.43",
      "en": "The finish preview shows how the last pieces fall.",
      "zh-CN": "收尾预览可以看最后几块碎片怎么落下。"
    },
    {
      "id": "tip.44",
      "en": "Try a less familiar category for your next challenge.",
      "zh-CN": "下一场挑战可以选一个不太熟悉的类型。"
    },
    {
      "id": "tip.45",
      "en": "You can preview a toy’s shape in the catalog.",
      "zh-CN": "可以在图鉴里先看看造型。"
    },
    {
      "id": "tip.46",
      "en": "Check your challenge inbox for shared runs.",
      "zh-CN": "好友分享的挑战会出现在挑战收件箱。"
    },
    {
      "id": "tip.47",
      "en": "Visit the settings screen to adjust audio and vibration.",
      "zh-CN": "可在设置里调节声音与震动。"
    },
    {
      "id": "tip.48",
      "en": "If browser sound is blocked, tap the start button first.",
      "zh-CN": "浏览器拦截声音时，先点一下开始按钮。"
    },
    {
      "id": "tip.49",
      "en": "Clear an active filter if the catalog looks empty.",
      "zh-CN": "图鉴看起来是空的时，先检查有没有开启筛选。"
    },
    {
      "id": "tip.50",
      "en": "A small change in pressure can make a different sound.",
      "zh-CN": "换一点按压力度，可能会听到不同的声音。"
    }
  ]
}
